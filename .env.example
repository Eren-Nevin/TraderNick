# ============================================================================
# TraderNick — environment template.
# Copy to `.env` and fill in. `.env` is gitignored (holds real secrets).
# Every key the stack reads is listed here; commented keys fall back to
# in-code defaults unless you uncomment and set them.
# ============================================================================

# --- Secrets / credentials (REPLACE all of these) ---------------------------
DEFISTREAM_API_KEY=dsk_replace_me
CLICKHOUSE_PASSWORD=tradernick
# admin_server API basic-auth (the dashboard's server-side admin proxy uses
# these internally; also the credential for direct curl to admin_server).
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
# Admin secret for the notification service HTTP endpoints.
NOTIFICATIONS_ADMIN_SECRET=change_me
# nginx HTTP basic-auth guarding the PUBLIC site (dashboard + admin pages).
# The SvelteKit app has no built-in login, so nginx enforces this in front of
# everything. Generate the htpasswd file from these (see DEPLOY.md).
WEB_AUTH_USER=admin
WEB_AUTH_PASSWORD=change_me
# PyPI upload token (only needed to publish the data_provider client). Leave
# blank unless you run `twine upload`.
PYPI_PASSWORD=

# --- System paths (host-specific — set these per server) --------------------
# Where ClickHouse stores its data on the HOST, and where data_provider
# snapshots live on the HOST. Both default to repo-local ./data/* so a fresh
# checkout runs without editing; point them at your real data disk in prod
# (e.g. /mnt/<disk>/tradernick/clickhouse). Nothing else in the repo hardcodes
# a host path — these two vars are the only system-specific settings.
CLICKHOUSE_DATA_DIR=./data/clickhouse
SNAPSHOTS_HOST_DIR=./data/snapshots
# Host path for the wallets bootstrap parquet (mounted read-only into ingestion).
WALLETS_PARQUET_HOST=./data

# --- Concurrency / limits ---------------------------------------------------
# Max concurrent backfill sub-jobs PER family (each *_backfill container has its
# own limit). Raise for faster catch-up if the host + DeFiStream budget allow.
MAX_CONCURRENT_BACKFILLS=8
# DeFiStream in-flight request cap (per ingestion process).
# DEFISTREAM_MAX_CONCURRENT=3
# Grace period (s) a cancelled backfill gets to exit on SIGTERM between chunks.
# CANCEL_GRACE_SECONDS=20

# --- Ingestion token set ----------------------------------------------------
INGEST_TOKENS=BTC,ETH,SOL,ARB,LINK,BNB,POL
# Extra named batch (the admin Token Batches store seeds from these on first run).
INGEST_TOKENS_BATCH_2=XRP,SUI,ONDO,XMR,CRV,AVAX,ADA,INJ,JUP,ICP,TIA,STRK,ZRO,JTO,FARTCOIN,ASTER,PENGU,TRUMP,WLFI,WIF,XPL
# Named batches as JSON ({"BatchName":"TOK1,TOK2,..."}).
INGEST_NAMED_BATCHES={"Majors":"BNB,BTC,ETH,SOL,XRP"}

# --- Transfers (per-chain) --------------------------------------------------
EVM_ERC20_TRANSFERS=ETH:USDT,USDC,DAI,LINK;ARB:USDT,USDC,DAI,LINK
EVM_NATIVE_TRANSFERS=ETH,ARB
BTC_TRANSFERS_ENABLED=1
# TRON native (TRX) ingestion — disabled by default (kind='tron_native').
TRON_NATIVE_TRANSFERS_ENABLED=0
TRON_TRC20_TRANSFERS=USDT

# --- DeFi protocol events (enable flags + chains) ---------------------------
AAVE_EVENTS_ENABLED=1
AAVE_EVENTS_CHAINS=ETH,ARB
AAVE_ETH_MARKETS=Core,Prime,EtherFi
AAVE_V2_CHAINS=ETH
MORPHO_CHAINS=ETH
LIDO_L2_CHAINS=ARB

# Uniswap V3 pool events. UNI_V3_POOLS is the full backfill catalogue;
# UNI_V3_LIVE_POOLS is a trimmed live-poll subset (keeps under DeFiStream's
# per-minute budget). Format: <chain>:<sym0/sym1/fee>,... (pairs auto-
# canonicalised alphabetically). Both fall back to in-code defaults if unset.
UNI_V3_ENABLED=1
UNI_V3_LIVE_POOLS=ETH:USDC/WETH/500,USDC/WETH/3000,USDT/WETH/500,USDC/WBTC/3000,WBTC/WETH/3000;ARB:USDC/WETH/500,ARB/USDC/500
# UNI_V3_POOLS=ETH:USDC/WETH/500,...;ARB:USDC/WETH/500,...
# Uniswap V4. Format: <chain>:<sym0/sym1/fee/tickSpacing/hooksAddr>,...
UNI_V4_POOLS=ETH:USDC/WETH/500/10/0x0000000000000000000000000000000000000000
UNI_V4_LIVE_POOLS=ETH:USDC/WETH/500/10/0x0000000000000000000000000000000000000000

# Lido liquid-staking events. Mainnet fires on ETH; L2 events fire on each
# chain in LIDO_L2_CHAINS. Defaults in-code; uncomment to override.
LIDO_EVENTS_ENABLED=1
# LIDO_ETH_EVENTS=deposit,withdrawal_request,withdrawal_claimed
# LIDO_L2_EVENTS=l2_deposit,l2_withdrawal_request

# --- Internal service URLs (docker service-name DNS; keep as-is unless you
#     rename services or split the compose across hosts) --------------------
HYPERLIQUID_LIVE_URL=http://hyperliquid_live:8000
HYPERLIQUID_BACKFILL_URL=http://hyperliquid_backfill:8000
BINANCE_LIVE_URL=http://binance_live:8000
BINANCE_BACKFILL_URL=http://binance_backfill:8000
TRANSFERS_LIVE_URL=http://transfers_live:8000
TRANSFERS_BACKFILL_URL=http://transfers_backfill:8000
AAVE_LIVE_URL=http://aave_live:8000
AAVE_BACKFILL_URL=http://aave_backfill:8000
UNISWAP_LIVE_URL=http://uniswap_live:8000
UNISWAP_BACKFILL_URL=http://uniswap_backfill:8000
AERODROME_LIVE_URL=http://aerodrome_live:8000
AERODROME_BACKFILL_URL=http://aerodrome_backfill:8000
LIDO_LIVE_URL=http://lido_live:8000
LIDO_BACKFILL_URL=http://lido_backfill:8000
MORPHO_LIVE_URL=http://morpho_live:8000
MORPHO_BACKFILL_URL=http://morpho_backfill:8000
SPARK_LIVE_URL=http://spark_live:8000
SPARK_BACKFILL_URL=http://spark_backfill:8000
GMX_LIVE_URL=http://gmx_live:8000
GMX_BACKFILL_URL=http://gmx_backfill:8000
DATA_PROCESS_LIVE_URL=http://data_process_live:8000
DATA_PROCESS_BACKFILL_URL=http://data_process_backfill:8000
TRADERNICK_ADMIN_URL=http://tradernick_admin:8000
DATA_PROVIDER_ADMIN_URL=http://admin_server:8000

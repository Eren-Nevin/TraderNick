DEFISTREAM_API_KEY=dsk_replace_me
CLICKHOUSE_PASSWORD=tradernick
INGEST_TOKENS=BTC,ETH,SOL,ARB,LINK,BNB,POL
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
MAX_CONCURRENT_BACKFILLS=4

EVM_ERC20_TRANSFERS=ETH:USDT,USDC,DAI,LINK;ARB:USDT,USDC,DAI,LINK;POLYGON:USDT,USDC,DAI,LINK;BASE:USDT,USDC,DAI,LINK;BSC:USDT,USDC,DAI,LINK
EVM_NATIVE_TRANSFERS=ETH,ARB,BASE,BSC,POLYGON
BTC_TRANSFERS_ENABLED=1
TRON_NATIVE_TRANSFERS_ENABLED=1
TRON_TRC20_TRANSFERS=USDT
AAVE_EVENTS_ENABLED=1
AAVE_EVENTS_CHAINS=ETH,ARB,BASE,BSC,POLYGON
AAVE_ETH_MARKETS=Core,Prime,EtherFi

# Uniswap V3 pool events. UNI_V3_POOLS is the full catalogue used by the
# 30-day backfill. UNI_V3_LIVE_POOLS is a trimmed subset polled at 60s tick
# (the full list would exceed DeFiStream's per-minute rate budget once you
# combine it with the AAVE poller). Format: <chain>:<sym0/sym1/fee>,... ;
# pairs are auto-canonicalised alphabetically. Both fields fall back to
# the in-code defaults if unset.
UNI_V3_ENABLED=1
# UNI_V3_POOLS=ETH:USDC/WETH/500,...;ARB:USDC/WETH/500,...;BASE:...;BSC:...;POLYGON:...
# UNI_V3_LIVE_POOLS=ETH:USDC/WETH/500,...;ARB:USDC/WETH/500,...
